rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /customers/{id} {
      allow read, write: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }
    match /transactions/{id} {
      allow read, write: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }
  }
}